# ==============================================================
# 深知 ShenZhi · B 模块（AI 助手 / 模型能力）环境变量示例
# --------------------------------------------------------------
# 【使用方法】
#   1. 复制本文件为「.env.local」，然后按需修改。
#      （.env.local 已被 .gitignore 忽略，**绝对不会进入 Git 仓库**，
#       因此真实密钥、本地调试地址只放在 .env.local 即可。）
#
# 【安全红线】
#   ❌ 严禁把下面任何占位符替换成真实值后再提交本 .env.example！
#   ❌ 严禁在任何 .ts/.tsx/.js 源码里直接写死 sk-xxxx / 密码 / Token！
#   ✅ 所有真实凭据仅存在于本机的 .env.local（或 CI 的 GitHub Secrets）。
#
# 【环境变量前缀规则】
#   NEXT_PUBLIC_ 开头 → 会注入到浏览器 JS（用于前端读取后端模式切换）
#   无前缀 → 仅 Node.js 服务端 route.ts 可读（密钥类必须用这种，永不进前端）
# ==============================================================

# ——————————————————————————————————————————————————————————————
# 1. AI 后端模式（前端可读，用于 UI 显示与请求路由）
# ——————————————————————————————————————————————————————————————
# B = 本项目 B 模块直接对接真实大模型（DeepSeek / 其他 OpenAI 兼容厂商）✅ 当前推荐
# A = 走 A 同学后端两步法「createSession → stream」协议（需要同时配置下面的 API_URL）
NEXT_PUBLIC_AI_BACKEND_MODE=B

# —— A 模式专用（NEXT_PUBLIC_AI_BACKEND_MODE=A 时才生效；B 模式可留空） ——
# A 后端基础地址（带协议，不要结尾 /）。示例：http://127.0.0.1:8000 或 ngrok 域名
# API_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# ——————————————————————————————————————————————————————————————
# 2. DeepSeek 真实模型接入（B 模式必填）
#    ⚠️  全部 无 NEXT_PUBLIC_ 前缀 → 仅服务端可读！
# ——————————————————————————————————————————————————————————————
# 从 https://platform.deepseek.com/api_keys 申请，sk- 开头一串
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek / 任何 OpenAI 兼容厂商的 Base URL，默认官方即可
# 自建 / 中转时改成你的域名（结尾不要带 /）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 默认模型（前端 Composer 选「default / subscription / byok」三档时会回落到此值）
#   deepseek-chat     → V4 / V3 Flash（日常首选，性价比最高）
#   deepseek-reasoner → R1 推理模型（数学 / 逻辑 / 代码，价格约 3 倍）
DEEPSEEK_MODEL=deepseek-chat

# ——————————————————————————————————————————————————————————————
# 3. C 模块联网搜索（C2 附件「联网搜索」能力，2026-08-20 新增）
#    ⚠️  全部 无 NEXT_PUBLIC_ 前缀 → 仅服务端可读！
#    优先级：Tavily 优先 → SearXNG 降级 → 两者都不配则自动返回空（联网开关点了也不报错）
# ——————————————————————————————————————————————————————————————
# ① Tavily（推荐，https://app.tavily.com 免费注册拿 tvly- 开头 key）
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ② SearXNG 自建实例（降级备选，JSON 输出；示例地址要改成你自建的实例）
# SEARXNG_BASE_URL=http://127.0.0.1:8080

# ——————————————————————————————————————————————————————————————
# 4. 其他凭据（规划中占位，接入时再填 .env.local）
# ——————————————————————————————————————————————————————————————
# NextAuth 认证
# AUTH_SECRET=

# 数据库（若以后接 ORM）
# DATABASE_URL=

# Vercel / 其他平台
# SENTRY_AUTH_TOKEN=
