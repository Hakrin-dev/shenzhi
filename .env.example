# 深知 ShenZhi 部署环境变量示例
# 复制为 .env 后按需填写。

# 将来接入真实后端时,前端访问后端的公网基础地址
# 示例:https://api.example.com 或 http://47.238.241.77:8080
# NEXT_PUBLIC_API_URL=

# Better Auth 服务端秘密,用于加密、签名与哈希;禁止使用 NEXT_PUBLIC_ 前缀。
# 使用高熵随机值,至少 32 个字符;正式环境必须单独配置。
# 真实 secret 不提交 Git。
BETTER_AUTH_SECRET=

# Better Auth 应用基础地址;本地开发使用 http://localhost:3000。
BETTER_AUTH_URL=http://localhost:3000

# PostgreSQL 连接地址,供 Better Auth 使用。
DATABASE_URL=
