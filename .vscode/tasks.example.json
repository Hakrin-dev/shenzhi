{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ShenZhi: 前端开发",
      "type": "shell",
      "command": "pnpm dev",
      "options": {
        "cwd": "${workspaceFolder}/apps/web"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "ShenZhi: 后端开发",
      "type": "shell",
      "command": "uv run uvicorn app.main:app --env-file .env --host 127.0.0.1 --port 8000 --reload",
      "options": {
        "cwd": "${workspaceFolder}/apps/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "ShenZhi: 全栈开发",
      "dependsOn": [
        "ShenZhi: 后端开发",
        "ShenZhi: 前端开发"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "ShenZhi: 更新依赖",
      "type": "shell",
      "command": "cd apps/backend && uv sync && cd ../web && pnpm install",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
